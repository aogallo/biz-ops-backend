# API Configuration
API_TITLE=Business Operations API
API_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# Auth0 Configuration (Required)
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://your-api-audience
AUTH0_ISSUER=https://your-tenant.auth0.com/
ALGORITHMS=RS256

# Database Configuration
# For local development with PostgreSQL:
# DATABASE_URI=postgresql+psycopg2://user:password@localhost:5432/bizops
# For production:
# DATABASE_URI=postgresql+psycopg2://user:password@prod-host:5432/bizops
DATABASE_URI=postgresql+psycopg2://user:password@localhost:5432/mydb

# Server Configuration (Optional)
HOST=0.0.0.0
PORT=8000

# CORS Configuration (Optional)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Security
SECRET_KEY=your-secret-key-here-change-in-production
