# Development Mode
# Set to true to use mock authentication (no real Auth0 needed)
# Set to false to use real Auth0 authentication
USE_MOCK_AUTH=true

# Debug Configuration
DEBUG=true
LOG_LEVEL=DEBUG

# API Configuration
API_TITLE=Business Operations API (Dev)
API_VERSION=1.0.0

# Auth0 Configuration
# When USE_MOCK_AUTH=true, these can be mock values
# When USE_MOCK_AUTH=false, replace with your real Auth0 credentials
AUTH0_DOMAIN=mock-tenant.auth0.com
AUTH0_AUDIENCE=https://mock-api-audience
AUTH0_ISSUER=https://mock-tenant.auth0.com/
ALGORITHMS=RS256

# Database Configuration
# Default values match docker-compose.yml PostgreSQL service
DATABASE_URI=postgresql+psycopg2://bizops:bizops_dev_password@localhost:5432/bizops_dev
